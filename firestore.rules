rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin flag lives on the user's own profile doc (users/{uid}.role == 'admin').
    // Only an existing admin (or the Firebase Console / Admin SDK, which bypasses
    // rules entirely) can ever set this field — see the users/{userId} rule below.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ─── users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
                    (!('role' in request.resource.data) || request.resource.data.role != 'admin');
      // Owners may update their own doc but can never touch `role` themselves —
      // prevents client-side self-promotion to admin. Only an admin (via console
      // or a future admin tool) can change `role`.
      allow update: if isAdmin() ||
                    (isOwner(userId) &&
                     request.resource.data.get('role', null) == resource.data.get('role', null));
      allow delete: if isAdmin();
    }

    // ─── children ─────────────────────────────────────────────────────────────
    match /children/{childId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ─── per-user activity / private data ────────────────────────────────────
    match /user_saved_products/{docId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /user_product_actions/{docId} {
      // Write-once analytics log. Admin dashboard aggregates across all users.
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if false;
    }

    match /product_click_logs/{docId} {
      allow read:   if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /price_alerts/{docId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /notifications/{userId}/user_notifications/{docId} {
      // Notifications are written server-side only (Admin SDK bypasses rules).
      // Clients may only read their own and mark them read.
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && onlyChangedFields(['isRead', 'readAt']);
      allow create, delete: if false;
    }

    // ─── reward claims (구매 인증 적립 신청) ─────────────────────────────────
    match /reward_claims/{docId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) &&
                       request.resource.data.status == 'pending';
      // Approval/rejection is a manual admin operation done outside client
      // rules for now (Firebase Console / Admin SDK) — see spec §11.2.
      allow update, delete: if false;
    }

    // ─── CS inquiries ─────────────────────────────────────────────────────────
    match /inquiries/{docId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) &&
                       request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── community: posts / comments ─────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if (isOwner(resource.data.userId) && resource.data.userId == request.resource.data.userId)
                    || (isSignedIn() && onlyChangedFields(['likeCount', 'likedBy']))
                    || (isSignedIn() && onlyChangedFields(['commentCount']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /comments/{commentId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── reviews ────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if (isOwner(resource.data.userId) && resource.data.userId == request.resource.data.userId)
                    || (isSignedIn() && onlyChangedFields(['likeCount']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /review_likes/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isOwner(request.resource.data.userId) || isOwner(resource.data.userId);
      allow update: if false;
    }

    // ─── product catalog (client-side registration architecture, RULE-05) ────
    // NOTE: products/offers stay writable by any signed-in user because the
    // app's core "1-pixel webview scraper" flow writes directly from the
    // client. This is a known residual risk (a malicious client could tamper
    // with prices) accepted for v1 — see launch notes. Tightening this
    // properly means moving product/offer writes behind a callable Function.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      // Price history — write-once by design (every check adds a NEW doc via
      // addDoc/.add(), client and server both; nothing ever updates an
      // existing offer, confirmed by grep across the app). update is closed
      // so a past observation can never be edited after the fact — an
      // append-only ledger is the whole point of a price *history*. create
      // still requires a plausible price, since this doc directly feeds the
      // marketing-average / discount-% shown to every viewer of the product.
      match /offers/{offerId} {
        allow read: if true;
        allow create: if isSignedIn()
                      && request.resource.data.price is number
                      && request.resource.data.price > 0
                      && request.resource.data.price < 50000000;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Daily max/min price bucket — written client-side on registration
      // (priceTrackingService.recordPrice) in addition to the scheduled
      // server-side price checks. Unlike offers this doc IS legitimately
      // updated (today's running max/min), so it can't be append-only —
      // instead the update rule enforces the one invariant every real write
      // already follows (_updateDailyPrice: maxPrice = Math.max(existing,
      // new), minPrice = Math.min(existing, new)): the range can only ever
      // widen, never move backwards or reset.
      match /daily_prices/{dateId} {
        allow read: if true;
        allow create: if isSignedIn()
                      && request.resource.data.maxPrice is number
                      && request.resource.data.minPrice is number
                      && request.resource.data.maxPrice > 0
                      && request.resource.data.maxPrice < 50000000
                      && request.resource.data.minPrice > 0
                      && request.resource.data.minPrice <= request.resource.data.maxPrice;
        allow update: if isSignedIn()
                      && request.resource.data.maxPrice is number
                      && request.resource.data.minPrice is number
                      && request.resource.data.maxPrice >= resource.data.maxPrice
                      && request.resource.data.minPrice <= resource.data.minPrice
                      && request.resource.data.maxPrice < 50000000
                      && request.resource.data.minPrice > 0;
        allow delete: if isAdmin();
      }

      // Denormalized registry of which options (color/size/quantity) of
      // this parent are actively tracked — written only by
      // onSavedProductCreate/Delete and scheduledPriceUpdate (Admin SDK
      // bypasses rules entirely), read by DetailScreen to show the option
      // label and by the price scheduler to enumerate what to check.
      match /trackedOptions/{optionId} {
        allow read: if true;
        // trackingCount is the one field only onSavedProductCreate/Delete
        // (Admin SDK, bypasses rules) may ever move — everything else
        // (optionId/vendorItemId/optionLabel/lastPrice) a signed-in client
        // can create/refresh directly when it discovers a sibling option
        // by click-simulating through the product page (see
        // clientProductRegistrar.js). diff().affectedKeys() (not a plain
        // "in" check) so a merge write that leaves an existing
        // trackingCount untouched isn't rejected just for that field being
        // present in the post-merge document.
        allow create: if isSignedIn() && !('trackingCount' in request.resource.data);
        allow update: if isSignedIn() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['trackingCount']);
        allow delete: if false;
      }
    }

    // Denormalized per-segment save counters (또래 추천) — written only by
    // the onSavedProductCreate/Delete Cloud Functions (Admin SDK bypasses
    // rules entirely), never directly by clients.
    match /segment_popularity/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Anything not explicitly matched above is closed by default (no
    // implicit allow-all fallback).
  }
}
