rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin flag lives on the user's own profile doc (users/{uid}.role == 'admin').
    // Only an existing admin (or the Firebase Console / Admin SDK, which bypasses
    // rules entirely) can ever set this field — see the users/{userId} rule below.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ─── users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
                    (!('role' in request.resource.data) || request.resource.data.role != 'admin');
      // Owners may update their own doc but can never touch `role` themselves —
      // prevents client-side self-promotion to admin. Only an admin (via console
      // or a future admin tool) can change `role`.
      allow update: if isAdmin() ||
                    (isOwner(userId) &&
                     request.resource.data.get('role', null) == resource.data.get('role', null));
      allow delete: if isAdmin();
    }

    // ─── children ─────────────────────────────────────────────────────────────
    match /children/{childId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ─── per-user activity / private data ────────────────────────────────────
    match /user_saved_products/{docId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /user_product_actions/{docId} {
      // Write-once analytics log. Admin dashboard aggregates across all users.
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if false;
    }

    match /product_click_logs/{docId} {
      allow read:   if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /price_alerts/{docId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /notifications/{userId}/user_notifications/{docId} {
      // Notifications are written server-side only (Admin SDK bypasses rules).
      // Clients may only read their own and mark them read.
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && onlyChangedFields(['isRead', 'readAt']);
      allow create, delete: if false;
    }

    // ─── reward claims (구매 인증 적립 신청) ─────────────────────────────────
    match /reward_claims/{docId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) &&
                       request.resource.data.status == 'pending';
      // Approval/rejection is a manual admin operation done outside client
      // rules for now (Firebase Console / Admin SDK) — see spec §11.2.
      allow update, delete: if false;
    }

    // ─── CS inquiries ─────────────────────────────────────────────────────────
    match /inquiries/{docId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) &&
                       request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── community: posts / comments ─────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if (isOwner(resource.data.userId) && resource.data.userId == request.resource.data.userId)
                    || (isSignedIn() && onlyChangedFields(['likeCount', 'likedBy']))
                    || (isSignedIn() && onlyChangedFields(['commentCount']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /comments/{commentId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── reviews ────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if (isOwner(resource.data.userId) && resource.data.userId == request.resource.data.userId)
                    || (isSignedIn() && onlyChangedFields(['likeCount']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /review_likes/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isOwner(request.resource.data.userId) || isOwner(resource.data.userId);
      allow update: if false;
    }

    // ─── product catalog (server-mediated writes) ─────────────────────────────
    // Was: any signed-in client wrote products/offers/daily_prices/
    // trackedOptions directly from its own scrape ("1픽셀 웹뷰" flow, RULE-05).
    // Now: the client still does the scrape (that's still how RULE-12 beats
    // Akamai — a server-origin fetch stays blocked), but submits it to
    // submitScrapedProduct instead of writing it — that Cloud Function
    // independently re-fetches the same page via Bright Data, only writes
    // (via Admin SDK, which bypasses these rules) if the two prices roughly
    // agree. So client create/update is closed here across the board; every
    // path below is Admin-SDK-only now. See the price-trust audit memo's
    // "정식 출시 전" milestone.
    match /products/{productId} {
      allow read: if true;
      allow create: if false;
      // reviewStats.* (reviewService.js, recomputed after each review) and
      // optionStats.* (productActionService.js, click/conversion counters)
      // are the only fields an ordinary signed-in client still legitimately
      // updates on this doc — everything price/identity-related (name,
      // currentPrice, image, ...) is submitScrapedProduct-only now.
      allow update: if isAdmin() || (isSignedIn() && onlyChangedFields(['reviewStats', 'optionStats', 'updatedAt']));
      allow delete: if isAdmin();

      // Price history — append-only (every check adds a NEW doc; nothing
      // ever updates an existing offer). Client writes closed entirely now
      // that submitScrapedProduct (Admin SDK) is the only path in.
      match /offers/{offerId} {
        allow read: if true;
        allow create, update: if false;
        allow delete: if isAdmin();
      }

      // Daily max/min price bucket. Client writes closed entirely — see
      // products/{productId} note above.
      match /daily_prices/{dateId} {
        allow read: if true;
        allow create, update: if false;
        allow delete: if isAdmin();
      }

      // Denormalized registry of which options (color/size/quantity) of
      // this parent are actively tracked. Client writes closed entirely —
      // submitScrapedProduct now writes sibling-option entries too (see its
      // file-header note on why those stay unverified-but-authenticated
      // rather than Bright-Data-confirmed like the primary price).
      match /trackedOptions/{optionId} {
        allow read: if true;
        allow create, update: if false;
        allow delete: if false;
      }
    }

    // Denormalized per-segment save counters (또래 추천) — written only by
    // the onSavedProductCreate/Delete Cloud Functions (Admin SDK bypasses
    // rules entirely), never directly by clients.
    match /segment_popularity/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Flagged by the onDailyPriceAnomaly trigger when a daily_prices write
    // jumps ≥30% from its prior value — a detective control, not preventive:
    // it doesn't block the write, just queues it for admin review. Admin SDK
    // only (bypasses rules); never written or read by an ordinary client.
    match /price_anomaly_review/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not explicitly matched above is closed by default (no
    // implicit allow-all fallback).
  }
}
